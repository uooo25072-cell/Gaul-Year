# GameZone Telegram Bot Configuration

# Telegram Bot Token obtained from @BotFather
BOT_TOKEN=7891234567:AAFxExampleTokenHere12345

# Telegram ID of the Super Admin (e.g. 123456789)
ADMIN_ID=123456789

# Optional TON API Key for Toncenter or Tonapi (can be blank for public endpoints)
TON_API_KEY=

# TON Wallet Address for receiving payments
TON_WALLET_ADDRESS=UQAerMfM0XruMQmynNMjIuKP7zu4AeMrVlUBRJgtxARyLq_H

# Interval in seconds to update TON price in EGP (default: 3600 seconds = 1 hour)
TON_PRICE_UPDATE_INTERVAL=3600

# Payment deadline in minutes (default: 20 minutes)
PAYMENT_TIMEOUT_MINUTES=20

# Interval in seconds to check pending payments and expirations (default: 10 seconds)
PAYMENT_CHECK_INTERVAL=10

# Database file location
DATABASE_PATH=data/gamezone.db

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
